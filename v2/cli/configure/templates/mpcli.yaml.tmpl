# TDNS MP CLI Configuration
# Generated by `tdns-mpcli configure`.

# API servers this CLI can talk to. `name:` is the lookup key of a
# built-in command word: tdns-mpagent for `tdns-mpcli agent ...`,
# tdns-mpsigner for `signer`, tdns-mpcombiner for `combiner` and
# tdns-mpauditor for `auditor`.
#
# baseurl: uses the internal IP (same as the daemons' apiserver
# bind), which is the only address reachable from the same host in
# NAT'd setups like AWS EC2 where the public IP isn't on any local
# interface. For remote mpcli use (operator's workstation), edit
# this to the externally-reachable host:port and arrange SSH tunnel
# or firewall access as appropriate.
# config-file: the daemon's own config, read by `... config check`
# and `... keys`.
# command: path to the daemon binary, used by `... daemon start`.
apiservers:
   - name:         tdns-mpsigner
     baseurl:      https://{{.SignerApiListen}}/api/v1
     apikey:       {{.Signer.ApiKey}}
     authmethod:   X-API-Key
     config-file:  {{.Layout.ConfigDir}}/tdns-mpsigner.yaml
     command:      {{.Layout.LibexecDir}}/tdns-mpsigner

   - name:         tdns-mpcombiner
     baseurl:      https://{{.CombinerApiListen}}/api/v1
     apikey:       {{.Combiner.ApiKey}}
     authmethod:   X-API-Key
     config-file:  {{.Layout.ConfigDir}}/tdns-mpcombiner.yaml
     command:      {{.Layout.LibexecDir}}/tdns-mpcombiner

   - name:         tdns-mpagent
     baseurl:      https://{{.AgentApiListen}}/api/v1
     apikey:       {{.Agent.ApiKey}}
     authmethod:   X-API-Key
     config-file:  {{.Layout.ConfigDir}}/tdns-mpagent.yaml
     command:      {{.Layout.LibexecDir}}/tdns-mpagent
{{if .Auditor.Identity}}
   - name:         tdns-mpauditor
     baseurl:      https://{{.AuditorApiListen}}/api/v1
     apikey:       {{.Auditor.ApiKey}}
     authmethod:   X-API-Key
     config-file:  {{.Layout.ConfigDir}}/tdns-mpauditor.yaml
     command:      {{.Layout.LibexecDir}}/tdns-mpauditor
{{end}}
log:
   file:   {{.Layout.LogDir}}/tdns-mpcli.log
   level:  info
