# TDNS MP Agent Configuration
# Generated by `tdns-mpcli configure`.

# Multi-provider config: identity of this agent + its peers
# (combiner and signer), and how each one is reached.
multi-provider:
   role:           agent
   # FQDN identity of this agent; appears in HSYNC3 records and
   # in CHUNK/HELLO/BEAT/PING signatures.
   identity:       {{.Agent.Identity}}
   # Active transport mechanisms ("api", "dns"). "dns" (NOTIFY+CHUNK
   # over DNS) is the one in use; the "api" HTTPS transport is partial.
   supported_mechanisms: [ dns ]
   # Path to this agent's long-term JOSE private key (P-256) used
   # to sign outbound CHUNK envelopes and authenticate to peers.
   long_term_jose_priv_key: {{.Paths.AgentJosePriv}}
   # Combiner peer: where this agent sends combiner-bound traffic
   # (UPDATE/SYNC/PING) and whose JOSE public key verifies inbound
   # combiner replies.
   combiner:
      identity:                {{.Combiner.Identity}}
      address:                 '{{.CombinerDnsDial}}'
      long_term_jose_pub_key:  {{.Paths.CombinerJosePub}}
   # Signer peer: where this agent fetches DNSKEY state (KEYSTATE
   # RFI) and verifies signer-signed responses.
   signer:
      identity:                {{.Signer.Identity}}
      address:                 '{{.SignerDnsDial}}'
      long_term_jose_pub_key:  {{.Paths.SignerJosePub}}
   # The agent's identity zone (e.g. agent.example.), created and
   # signed by the agent at startup.
   local:
      # FQDNs published as NS RDATA in the identity zone.
      nameservers:   [ {{range $i, $ns := .Agent.LocalNameservers}}{{if $i}}, {{end}}{{$ns}}{{end}} ]
      # host:port addresses of downstream secondaries that should
      # receive NOTIFY when the identity zone changes.
      notify:        [ {{range $i, $n := .Agent.LocalNotify}}{{if $i}}, {{end}}'{{$n}}'{{end}} ]
   # Inter-agent zone-transfer endpoints, advertised on demand via
   # CONFIG upstream/downstream requests from peer agents. Empty
   # lists mean "this agent does not act as XFR source/destination
   # for peer agents" — fine for setups where secondaries pull from
   # the agent's own DNS service instead.
   xfr:
      outgoing:
         addresses:  []
         auth:       []
      incoming:
         addresses:  []
         auth:       []
   # HTTPS endpoint of the "api" transport. The agent always starts
   # its agent-to-agent sync API on these addresses; with publish
   # empty (and no "api" in supported_mechanisms) it is not
   # advertised to peers.
   api:
      addresses:
         publish:    []
         listen:     [ '{{.AgentSyncApiListen}}' ]
      baseurl:       https://api.{TARGET}:{PORT}/api/v1
      port:          {{.AgentSyncApiPort}}
      certfile:      {{.Paths.AgentCert}}
      keyfile:       {{.Paths.AgentKey}}
   # DNS endpoint (NOTIFY+CHUNK signaling): the address peers use to
   # reach this agent for MP traffic. The listen address must be one
   # the listeners: block below binds.
   dns:
      addresses:
         # Externally-reachable IP advertised to peers.
         publish:    [ '{{.Global.PublicIP}}' ]
         listen:     [ '{{.AgentDnsListen}}' ]
      # URL template published as a DNS URI RR in the agent's
      # identity zone. Remote agents fetch this URI during their
      # LocateAgent discovery to learn how to reach this agent for
      # MP signaling. {TARGET} and {PORT} are substituted at
      # publication time.
      baseurl:       dns://dns.{TARGET}:{PORT}/
      port:          {{.AgentDnsPort}}
   # Timers of the gossip + discovery loops, in seconds. These are
   # the defaults; lower values are useful for testbeds.
   syncengine:
      intervals:
         beatinterval:        30   # between BEATs
         helloretry:          15   # between HELLO retries (steady)
         discoveryretry:      15   # between LocateAgent retries
         reconcile:           60   # between full peer reconciliations
         hello_fast_attempts: 3    # initial fast HELLO attempts before backoff
         hello_fast_interval: 2    # between the first N HELLO attempts

service:
   name:           TDNS-MPAGENT
   verbose:        true
   debug:          false

# Where the agent's DNS service listens: zone serving, AXFR, NOTIFY
# and the MP signaling of multi-provider.dns. The wildcard of the
# internal IP's address family (0.0.0.0 or ::) = every interface.
listeners:
   addresses:      [ '{{.AgentDnsListen}}' ]
   # do53 = classic UDP/TCP; dot, doh and doq also need
   # listeners.certfile/keyfile.
   transports:     [ do53 ]

# Management API (used by tdns-mpcli for control/inspection).
apiserver:
   addresses:      [ '{{.AgentApiListen}}' ]
   # Pre-shared key for X-API-Key auth; matches mpcli's config.
   apikey:         {{.Agent.ApiKey}}
   certfile:       {{.Paths.AgentCert}}
   keyfile:        {{.Paths.AgentKey}}

# Delegation sync towards the parent of a customer zone whose
# HSYNCPARAM makes the agents responsible for it (parentsync="agent").
parentsync:
   # NOTIFY(CDS/CSYNC) and/or DNS UPDATE, in order of preference.
   schemes:     [ notify, update ]
   update:
      keygen:
         # Algorithm of the SIG(0) keys that sign the UPDATEs.
         algorithm:  ED25519

# Internal resolver used for agent discovery (URI, SVCB and JWK
# records under remote agents' identities).
imrengine:
   active:         true
   # Security-sensitive lookups (TLSA and the like) must validate.
   require-dnssec-validation: true

# The policy the agent signs its identity zone with.
dnssec:
   kasp:
      # Short, for a testbed; see sigvalidity below.
      propagation-delay:  5m
   policies:
      default:
         algorithm:   ED25519
         ksk:
            lifetime:  forever   # "forever" | Go duration
         zsk:
            lifetime:  forever
         csk:
            lifetime:  none      # "none": separate KSK and ZSK
         # RRSIG validity: dnskey for the DNSKEY RRset, ds for DS
         # RRsets, default for everything else. Short, for a testbed.
         # tdns refuses a validity at or below 2 x (largest served TTL
         # + kasp.propagation-delay) and warns below 4 x; the identity
         # zone is served with a 1h TTL.
         sigvalidity:
            default:   6h
            dnskey:    6h
            ds:        6h

db:
   file:  {{.Layout.DbDir}}/tdns-mpagent.db

log:
   file:   {{.Layout.LogDir}}/tdns-mpagent.log
   level:  info

# If the templates: and zones: sections grow large, move them to a
# separate YAML file and pull it in via a top-level "include:" entry.
templates:
   - name:           mpzone
     type:           secondary
     # Where zone data is held: "map" (in-memory map) is the right
     # choice for MP zones.
     store:          map
     # The agent pulls the signed zone from the local signer.
     primaries:      [ { addr: '{{.SignerDnsDial}}', key: NOKEY } ]
     # "multi-provider" enables the MP pipeline (HSYNC3 evaluation,
     # combiner edits, signer KEYSTATE, etc.).
     options:        [ multi-provider ]

zones:
   # The example zone. A customer zone is added the same way.
   - name:           {{.ExampleZone}}
     template:       mpzone
