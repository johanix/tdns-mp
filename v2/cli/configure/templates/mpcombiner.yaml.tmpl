# TDNS MP Combiner Configuration
# Generated by `tdns-mpcli configure`.

# Multi-provider config: combiner's identity and which agents it
# accepts edits/SYNCs from.
multi-provider:
   role:      combiner
   # FQDN identity of this combiner; verified by peers against the
   # JOSE public key they have for it.
   identity:  {{.Combiner.Identity}}
   long_term_jose_priv_key:  {{.Paths.CombinerJosePriv}}

   # Agent peers this combiner accepts edits from. Each entry must
   # match an agent's identity FQDN; address is where the combiner
   # dials the agent (e.g. to deliver CHUNK responses).
   agents:
      - identity:               {{.Agent.Identity}}
        address:                '{{.AgentDnsDial}}'
        long_term_jose_pub_key: {{.Paths.AgentJosePub}}

   # Optional HTTPS sync API (alternative to NOTIFY+CHUNK).
   # Disabled by default — DNS transport is the primary mechanism.
   # syncapi:
   #    addresses:
   #       listen:     [ '127.0.0.1:8992' ]
   #    certfile:      {{.Paths.CombinerCert}}
   #    keyfile:       {{.Paths.CombinerKey}}

service:
   name:           TDNS-MPCOMBINER
   verbose:        true
   debug:          false

# Where the combiner's DNS service listens. The signer (and the
# auditor) transfer the combined zones from here.
listeners:
   addresses:      [ '{{.CombinerDnsListen}}' ]
   transports:     [ do53 ]

authengine:
   # Keep the SOA serial handed to the signer across restarts, so the
   # signer never sees it go backwards.
   outbound-soa-serial:  persist

apiserver:
   addresses:      [ '{{.CombinerApiListen}}' ]
   apikey:         {{.Combiner.ApiKey}}
   certfile:       {{.Paths.CombinerCert}}
   keyfile:        {{.Paths.CombinerKey}}

db:
   file:  {{.Layout.DbDir}}/tdns-mpcombiner.db

log:
   file:   {{.Layout.LogDir}}/tdns-mpcombiner.log
   level:  info

# If the templates: and zones: sections grow large, move them to a
# separate YAML file and pull it in via a top-level "include:" entry.
templates:
   - name:           mpzone
     store:          map
     options:        [ multi-provider ]
     # After combining, NOTIFY the local roles that transfer the zone.
     notify:         [ { addr: '{{.SignerDnsDial}}', key: NOKEY }{{if .Auditor.Identity}}, { addr: '{{.AuditorDnsDial}}', key: NOKEY }{{end}} ]
     # Who may transfer the combined zone: the local roles.
     downstreams:    [ { prefix: '{{.InternalPrefix}}', key: NOKEY } ]

zones:
   # The example zone, loaded from a file that stands in for the zone
   # owner's primary.
   - name:           {{.ExampleZone}}
     template:       mpzone
     type:           primary
     zonefile:       {{.Paths.ExampleZoneFile}}

   # A customer zone is a secondary of the zone owner's primary, which
   # must allow this combiner to transfer the zone and NOTIFY it:
   # - name:           customer.example.
   #   template:       mpzone
   #   type:           secondary
   #   primaries:      [ { addr: '203.0.113.53:53', key: NOKEY } ]
