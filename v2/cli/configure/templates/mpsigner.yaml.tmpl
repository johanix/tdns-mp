# TDNS MP Signer Configuration
# Generated by `tdns-mpcli configure`.

# Multi-provider config: signer's identity, peers (agents), and
# whether this signer is currently active in the MP pipeline.
multi-provider:
   role:      signer
   # When false, the signer accepts traffic but does not sign zones.
   # Used to retire a signer from a multi-signer setup gracefully.
   active:    true
   # FQDN identity of this signer.
   identity:  {{.Signer.Identity}}
   long_term_jose_priv_key:  {{.Paths.SignerJosePriv}}

   # Agent peers this signer expects to talk to. Each entry must
   # match an agent's identity FQDN; address is where to dial it.
   agents:
      - identity:               {{.Agent.Identity}}
        address:                '{{.AgentDnsDial}}'
        long_term_jose_pub_key: {{.Paths.AgentJosePub}}

   # Optional HTTPS sync API (alternative to NOTIFY+CHUNK for
   # HELLO/BEAT/PING). Disabled by default — DNS transport is the
   # primary mechanism.
   # syncapi:
   #    addresses:
   #       listen:     [ '127.0.0.1:8991' ]
   #    certfile:      {{.Paths.SignerCert}}
   #    keyfile:       {{.Paths.SignerKey}}

service:
   name:           TDNS-MPSIGNER
   verbose:        true
   debug:          false

# Where the signer's DNS service listens: its high port for the
# local roles, and 53 for everyone else.
listeners:
   addresses:      [ '{{.SignerDnsListen}}', '{{.SignerDnsListen53}}' ]
   transports:     [ do53 ]

authengine:
   # Keep the SOA serial served to the agent across restarts, so the
   # agent never sees it go backwards.
   outbound-soa-serial:  persist

apiserver:
   addresses:      [ '{{.SignerApiListen}}' ]
   apikey:         {{.Signer.ApiKey}}
   certfile:       {{.Paths.SignerCert}}
   keyfile:        {{.Paths.SignerKey}}

dnssec:
   # Key and Signing Policy: drives the key-state worker's automatic
   # transitions and standby-key maintenance.
   kasp:
      # How long to wait for DNSKEY changes to propagate before
      # advancing key state (published -> standby, retired -> removed).
      # Short, for a testbed.
      propagation-delay:  5m
      # How often the key-state worker runs its checks.
      check-interval:     1m
      # Standby ZSKs to keep ready per zone.
      standby-zsk-count:  1
      # Same for KSKs. 0 = no standby KSKs.
      standby-ksk-count:  0
   # Named DNSSEC policies. Zones reference one via dnssecpolicy:.
   policies:
      default:
         algorithm:   ED25519
         ksk:
            lifetime:  forever   # "forever" | Go duration
         zsk:
            lifetime:  forever
         csk:
            lifetime:  none      # "none": separate KSK and ZSK
         # RRSIG validity: dnskey for the DNSKEY RRset, ds for DS
         # RRsets, default for everything else. Short, for a testbed.
         # tdns refuses a validity at or below 2 x (largest served TTL
         # + kasp.propagation-delay) and warns below 4 x.
         sigvalidity:
            default:   6h
            dnskey:    6h
            ds:        6h

db:
   file:  {{.Layout.DbDir}}/tdns-mpsigner.db

log:
   file:   {{.Layout.LogDir}}/tdns-mpsigner.log
   level:  info

# If the templates: and zones: sections grow large, move them to a
# separate YAML file and pull it in via a top-level "include:" entry.
templates:
   - name:           mpzone
     type:           secondary
     store:          map
     # The signer pulls zone data from the local combiner.
     primaries:      [ { addr: '{{.CombinerDnsDial}}', key: NOKEY } ]
     options:        [ multi-provider ]
     # Policy applied if HSYNCPARAM puts this provider in the signers
     # set; otherwise this signer serves the zone unsigned.
     dnssecpolicy:   default
     # After signing, NOTIFY the agent so it pulls the new serial.
     notify:         [ { addr: '{{.AgentDnsDial}}', key: NOKEY } ]
     # Who may transfer the signed zone: the local roles.
     downstreams:    [ { prefix: '{{.InternalPrefix}}', key: NOKEY } ]

zones:
   # The example zone. A customer zone is added the same way.
   - name:           {{.ExampleZone}}
     template:       mpzone
