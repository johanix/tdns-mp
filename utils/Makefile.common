VERSION=`cat ../../VERSION`
BRANCH:=`git rev-parse --abbrev-ref HEAD 2>/dev/null || echo nogit`
COMMIT:=`git describe --dirty=+WiP --always 2>/dev/null || echo unknown`
APPDATE=`date +"%Y-%m-%d-%H:%M"`

GOFLAGS:=-v

# PQ algorithm selection is not a build-time WITH_* / -tags choice any more.
# An app that wants algorithms beyond the classical built-ins declares them
# in its algs.list; tdns-genalgs (tdns/cmdv2/genalgs, on PATH or pointed at
# by GENALGS) emits the registration files, a per-app C-library env
# (algs-libs.mk) and a shared ALGREPO cache (../algs-env.mk under cmd/).
# Mirrors tdns/utils/Makefile.common; today only mpsigner has an algs.list.
#
# ALGS_ENV (default empty; algs-libs.mk overrides it when the app selects
# C-backed algorithms) holds `VAR="val" ...` for the library env those
# algorithms need. It is spliced onto the `go build` command line rather than
# `export`ed, because NetBSD's base make does not implement GNU make's
# export-to-environment semantics.
ALGS_ENV :=

# The generator binary: tdns-genalgs on PATH, or a sibling tdns checkout's.
GENALGS ?= `command -v tdns-genalgs 2>/dev/null || echo ../../../tdns/cmdv2/genalgs/tdns-genalgs`

GOOS ?= $(shell uname -s | tr A-Z a-z)

default: ${PROG}

${PROG}: build

all: $(PROG)

version:
	/bin/sh ../../utils/make-version.sh $(VERSION)-$(BRANCH)-$(COMMIT) $(APPDATE) $(PROG)

# The go build itself runs in a sub-make (gobuild). This make read
# algs-libs.mk when it started, before `generate` ran. In an app with no
# generated files the file did not exist yet, so ALGS_ENV was empty and the
# build could not find the C libraries (`Package liboqs-go was not found in
# the pkg-config search path`); a second `make` then worked. The sub-make
# reads the Makefiles afresh, and with them the algs-libs.mk that `generate`
# has just written. Same fix as tdns's utils/Makefile.common.
build: generate
	@test -f version.go || /bin/sh ../../utils/make-version.sh "unknown" "unknown" $(PROG)
	@$(MAKE) gobuild

gobuild:
	$(ALGS_ENV) $(GO) build $(GOFLAGS) -o ${PROG}

# Algorithm code generation. No algs.list: the classical built-ins only,
# genalgs is not run and dnssec-algorithms is not needed. With an algs.list:
# genalgs is re-run whenever the generated files are missing or older than
# the list, using the dnssec-algorithms checkout recorded as ALGREPO in the
# shared ../algs-env.mk; on the first build run it once with --algrepo.
generate:
	@if [ ! -f algs.list ]; then \
	   : "no algs.list -> standalone build, genalgs not run"; \
	 elif [ -f registered_algs.go ] && [ ! algs.list -nt registered_algs.go ] && [ -f algs-libs.mk ] && [ -f ../algs-env.mk ]; then \
	   : "generated files are current"; \
	 elif [ -n "$(ALGREPO)" ]; then \
	   echo "  algs.list changed (or no generated files); running genalgs --algrepo $(ALGREPO)"; \
	   $(GENALGS) --algrepo "$(ALGREPO)" --list algs.list --out . || exit 1; \
	 else \
	   echo ""; \
	   echo "  $(PROG): algs.list is present but the generated files are missing"; \
	   echo "  or stale, and the dnssec-algorithms location is unknown."; \
	   echo "  Run genalgs once, pointing --algrepo at your dnssec-algorithms checkout:"; \
	   echo ""; \
	   echo "    $(GENALGS) --algrepo <path-to-dnssec-algorithms> --list algs.list --out ."; \
	   echo ""; \
	   exit 1; \
	 fi

netbsd:
	GOOS=netbsd GOARCH=amd64 $(ALGS_ENV) $(GO) build $(GOFLAGS) -o ${PROG}.netbsd

test:
	$(GO) test -v -cover

# --- packages -----------------------------------------------------------
#
# Five NetBSD binary packages, one per component: tdns-mpagent, tdns-mpcombiner,
# tdns-mpsigner and tdns-mpauditor each ship their own daemon under libexec,
# and tdns-mpcli ships the client under bin. The rules mirror tdns's
# utils/Makefile.common; see utils/mkpkg.sh for why a package rather than a
# tarball, and for the pkg_create details that are not obvious.
#
# The file lists are exactly the paths each app's OWN "install:" target places
# under /usr/local. The package is a REAL make target with the app's own built
# binary AND install as prerequisites: depending on the installed copy alone
# lets a rebuilt-but-not-installed app ship a stale binary inside a package
# stamped with today's date, which is what happened once in labstuff. install
# is phony, so the package is repacked on every "make pkg"; a repack costs
# seconds, a stale binary reaching a booted host silently cost days.
#
# "!=" rather than "$(shell ...)": $(shell) is GNU-make only and under NetBSD's
# bmake expands to NOTHING, silently, which once produced a full-size
# VERSIONLESS package. mkpkg.sh refuses such a version; this is the other half.
# "!=" needs bmake or GNU make 4.0+ (macOS still ships 3.81): build the
# packages on the NetBSD build host.
PKGBASEVER!= for f in ../../VERSION ../VERSION VERSION; do if [ -f "$$f" ]; then sed -e 's/^[vV]//' -e 's/[^0-9.].*$$//' "$$f"; break; fi; done 2>/dev/null || echo ""
PKGDATE!= date +%Y%m%d
PKGVER=$(PKGBASEVER).$(PKGDATE)

PKG_TDNS_MPAGENT:=tdns-mpagent-$(PKGVER).tgz
PKG_TDNS_MPCOMBINER:=tdns-mpcombiner-$(PKGVER).tgz
PKG_TDNS_MPSIGNER:=tdns-mpsigner-$(PKGVER).tgz
PKG_TDNS_MPAUDITOR:=tdns-mpauditor-$(PKGVER).tgz
PKG_TDNS_MPCLI:=tdns-mpcli-$(PKGVER).tgz

pkg_tdns_mpagent: $(PKG_TDNS_MPAGENT)
$(PKG_TDNS_MPAGENT): $(PROG) install
	PKGVERSION=$(PKGVER) \
	PKGCOMMENT="tdns-mpagent, the multi-provider agent" \
	/bin/sh ../../utils/mkpkg.sh tdns-mpagent /usr/local \
	libexec/tdns-mpagent

pkg_tdns_mpcombiner: $(PKG_TDNS_MPCOMBINER)
$(PKG_TDNS_MPCOMBINER): $(PROG) install
	PKGVERSION=$(PKGVER) \
	PKGCOMMENT="tdns-mpcombiner, the multi-provider zone combiner" \
	/bin/sh ../../utils/mkpkg.sh tdns-mpcombiner /usr/local \
	libexec/tdns-mpcombiner

pkg_tdns_mpsigner: $(PKG_TDNS_MPSIGNER)
$(PKG_TDNS_MPSIGNER): $(PROG) install
	PKGVERSION=$(PKGVER) \
	PKGCOMMENT="tdns-mpsigner, the multi-provider DNSSEC signer" \
	/bin/sh ../../utils/mkpkg.sh tdns-mpsigner /usr/local \
	libexec/tdns-mpsigner

pkg_tdns_mpauditor: $(PKG_TDNS_MPAUDITOR)
$(PKG_TDNS_MPAUDITOR): $(PROG) install
	PKGVERSION=$(PKGVER) \
	PKGCOMMENT="tdns-mpauditor, the multi-provider auditor" \
	/bin/sh ../../utils/mkpkg.sh tdns-mpauditor /usr/local \
	libexec/tdns-mpauditor

pkg_tdns_mpcli: $(PKG_TDNS_MPCLI)
$(PKG_TDNS_MPCLI): $(PROG) install
	PKGVERSION=$(PKGVER) \
	PKGCOMMENT="tdns-mpcli, the multi-provider command-line tool" \
	/bin/sh ../../utils/mkpkg.sh tdns-mpcli /usr/local \
	bin/tdns-mpcli

.PHONY: build gobuild generate version clean
