VERSION=`cat ../../VERSION`
BRANCH:=`git rev-parse --abbrev-ref HEAD 2>/dev/null || echo nogit`
COMMIT:=`git describe --dirty=+WiP --always 2>/dev/null || echo unknown`
APPDATE=`date +"%Y-%m-%d-%H:%M"`

GOFLAGS:=-v

# PQ algorithm selection is not a build-time WITH_* / -tags choice any more.
# An app that wants algorithms beyond the classical built-ins declares them
# in its algs.list; tdns-genalgs (tdns/cmdv2/genalgs, on PATH or pointed at
# by GENALGS) emits the registration files, a per-app C-library env
# (algs-libs.mk) and a shared ALGREPO cache (../algs-env.mk under cmd/).
# Mirrors tdns/utils/Makefile.common; today only mpsigner has an algs.list.
#
# ALGS_ENV (default empty; algs-libs.mk overrides it when the app selects
# C-backed algorithms) holds `VAR="val" ...` for the library env those
# algorithms need. It is spliced onto the `go build` command line rather than
# `export`ed, because NetBSD's base make does not implement GNU make's
# export-to-environment semantics.
ALGS_ENV :=

# The generator binary: tdns-genalgs on PATH, or a sibling tdns checkout's.
GENALGS ?= `command -v tdns-genalgs 2>/dev/null || echo ../../../tdns/cmdv2/genalgs/tdns-genalgs`

GOOS ?= $(shell uname -s | tr A-Z a-z)

default: ${PROG}

${PROG}: build

all: $(PROG)

version:
	/bin/sh ../../utils/make-version.sh $(VERSION)-$(BRANCH)-$(COMMIT) $(APPDATE) $(PROG)

build: generate
	@test -f version.go || /bin/sh ../../utils/make-version.sh "unknown" "unknown" $(PROG)
	$(ALGS_ENV) $(GO) build $(GOFLAGS) -o ${PROG}

# Algorithm code generation. No algs.list: the classical built-ins only,
# genalgs is not run and dnssec-algorithms is not needed. With an algs.list:
# genalgs is re-run whenever the generated files are missing or older than
# the list, using the dnssec-algorithms checkout recorded as ALGREPO in the
# shared ../algs-env.mk; on the first build run it once with --algrepo.
generate:
	@if [ ! -f algs.list ]; then \
	   : "no algs.list -> standalone build, genalgs not run"; \
	 elif [ -f registered_algs.go ] && [ ! algs.list -nt registered_algs.go ] && [ -f algs-libs.mk ] && [ -f ../algs-env.mk ]; then \
	   : "generated files are current"; \
	 elif [ -n "$(ALGREPO)" ]; then \
	   echo "  algs.list changed (or no generated files); running genalgs --algrepo $(ALGREPO)"; \
	   $(GENALGS) --algrepo "$(ALGREPO)" --list algs.list --out . || exit 1; \
	 else \
	   echo ""; \
	   echo "  $(PROG): algs.list is present but the generated files are missing"; \
	   echo "  or stale, and the dnssec-algorithms location is unknown."; \
	   echo "  Run genalgs once, pointing --algrepo at your dnssec-algorithms checkout:"; \
	   echo ""; \
	   echo "    $(GENALGS) --algrepo <path-to-dnssec-algorithms> --list algs.list --out ."; \
	   echo ""; \
	   exit 1; \
	 fi

netbsd:
	GOOS=netbsd GOARCH=amd64 $(ALGS_ENV) $(GO) build $(GOFLAGS) -o ${PROG}.netbsd

test:
	$(GO) test -v -cover

.PHONY: build generate version clean
